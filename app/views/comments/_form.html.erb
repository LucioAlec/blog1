<%=form_with(model: [@post, @comment])  do |f| %>
  <div class="mb-4">
  <%= f.label :description, class: "block" %>
  <%= f.text_area :description, class: "block border w-full px-3 py-2 rounded focus:ring-2 focus:ring-green-500"%>
  </div>


  <%= f.submit(
    @comment.persisted? ? "Update comment" : "Create comment",
    class: "bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded cursor-pointer mb-4 transition duration-500") 
  %>
<% end %>
