<h1 class="text-3xl font-bold mb-6 mt-2 "> Posts </h1>


<% @posts.each do |p| %>
  <h2 class="mb-3"><%= link_to p.title, post_path(p), class: "inline-block bg-blue-600 text-white px-4 py-2 rounded" %> </h2>

  <% end %>

<p> <%= link_to "Create a Post", new_post_path,
    class: "inline-block bg-green-600 text-white px-4 py-2 rounded" %> 
</p>