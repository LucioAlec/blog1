<h1 class="text-3xl font-bold mb-6"> Posts </h1>


<% @posts.each do |p| %>
  <h2 class="mb-3"><%= link_to p.title, post_path(p), class: "inline-block bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded transition duration-500" %> </h2>

  <% end %>

<p> <%= link_to "Create a Post", new_post_path,
    class: "mt-4 inline-block bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded transition duration-500" %> 
</p>