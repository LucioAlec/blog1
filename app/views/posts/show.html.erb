<h1 class= "text-3x1 font-bold mb-6">
 Post <%= @post.title %>
</h1>

<h3 class="mb-5"> Description </h3>

<section class= "mb-8">

  <p class="mb-4"> 
  <%= @post.description %> 
  </p>
  <div class= "flex gap-2 mb-4">
  <%= link_to "Edit", edit_post_path(@post), class: "inline-block bg-blue-600 hover:bg-blue-700 text-white px-5 py-2 rounded" %>
  <%= link_to "Delete", post_path(@post), class: "inline-block bg-red-600 hover:bg-red-700 text-white px-5 py-2 rounded",
      data: {turbo_method: :delete, turbo_confirm: "Sure?"}
  %>
  </div>

  <p> <%= link_to "Make a comment", new_post_comment_url(@post), 
  class: "inline-block bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded" %> 
  </p>

</section>
  
<section class="mb-8">
  <h4 class="text-1 font-bold mb-4"> Comments for <%= @post.title %> </h4>

    
  <% @comments.each do |c| %> 
    <div class="border rounded p-4 mb-4">
      <p class= "mb-2">  
        <%= c.description %>
      </p>

      <p class= "mb-3">
        <%=c.created_at.strftime("%d/%m/%Y %H:%M") %>
      </p>

      <div class="flex gap-2">
        <%= link_to "Edit", edit_post_comment_path(@post,c), 
        class: "bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded" %>

        <%= link_to "Delete", post_comment_path(@post,c), class: "bg-red-600 hover:bg-red-700 text-white px-4 py-2 rounded",
          data: {turbo_method: :delete, turbo_confirm: "Sure?"} 
        %> 
      </div>
    </div>
  <%end%>
  </section>


<%= link_to "Back to posts", posts_path, class: "inline-block bg-gray-500 hover:bg-gray-600 text-white px-4 py-2 rounded" %>
</p>